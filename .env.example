# Single source of truth for every API key and shared setting in this repo.
#
# Copy this file to `.env` at the repo root and fill in the values:
#     cp .env.example .env
#
# ONE OpenRouter key powers every service:
#   website/         -> idea evaluation (raw OpenRouter client)
#   evalreport/      -> Streamlit "Outshift Research Intelligence" (OpenAI SDK pointed at OpenRouter)
#
# `.env` is gitignored — never commit it.

# ---------------------------------------------------------------------------
# API key — one key for everything. Get one at https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Smithery API key — lets agents call their MCP servers (deep mode).
# Get one at https://smithery.ai/account/api-keys
# ---------------------------------------------------------------------------
SMITH_API_KEY=

# ---------------------------------------------------------------------------
# Models (OpenRouter model ids)
# ---------------------------------------------------------------------------
EVALREPORT_MODEL=openai/gpt-oss-120b
LLM_MODEL=openrouter/openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# SLIM transport (AGNTCY) — used by website/.
# setup.sh generates a random SLIM_SHARED_SECRET for you.
# ---------------------------------------------------------------------------
SLIM_SERVER=slim:46357
SLIM_SHARED_SECRET=slim-shared-secret-REPLACE_WITH_RANDOM_32PLUS_CHARS

# ---------------------------------------------------------------------------
# Host user/group id — the containers run as this user so the files they write
# into the mounted directories (logs/, council_results/, website/data/,
# _artifacts/, _artifactfactory-data/) stay owned by you instead of root.
# setup.sh and run.sh fill these in automatically; to set them by hand run:
#   printf 'HOST_UID=%s\nHOST_GID=%s\n' "$(id -u)" "$(id -g)"
# ---------------------------------------------------------------------------
HOST_UID=1000
HOST_GID=1000