# Single source of truth for every API key and shared setting in this repo.
#
# Copy this file to `.env` at the repo root and fill in the values:
#     cp .env.example .env
#
# ONE OpenRouter key powers every service:
#   backend/         -> idea evaluation (raw OpenRouter client)
#   backend/legacy/  -> the earlier negotiation demo (litellm, routed via OpenRouter)
#   evalreport/      -> Streamlit "Outshift Research Intelligence" (OpenAI SDK pointed at OpenRouter)
#
# `.env` is gitignored — never commit it.

# ---------------------------------------------------------------------------
# API key — one key for everything. Get one at https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Models (OpenRouter model ids)
# ---------------------------------------------------------------------------
EVALREPORT_MODEL=openai/gpt-4.1-mini
LLM_MODEL=openrouter/anthropic/claude-sonnet-5-5

# ---------------------------------------------------------------------------
# SLIM transport (AGNTCY) — used by backend/ and backend/legacy/.
# setup.sh generates a random SLIM_SHARED_SECRET for you.
# ---------------------------------------------------------------------------
SLIM_SERVER=slim:46357
SLIM_SHARED_SECRET=slim-shared-secret-REPLACE_WITH_RANDOM_32PLUS_CHARS